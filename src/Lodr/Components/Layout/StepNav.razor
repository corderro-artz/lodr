@inject AppState AppState
@implements IDisposable

<div class="flex items-center justify-between">
    <button class="px-5 py-2 rounded-lg bg-gray-800 hover:bg-gray-700 text-sm font-medium
                   disabled:opacity-30 disabled:cursor-not-allowed transition-colors"
            @onclick="AppState.PrevStep"
            disabled="@(AppState.CurrentStep == 0)">
        ← Back
    </button>

    <div class="flex items-center gap-3">
        @for (int i = 0; i < _stepLabels.Length; i++)
        {
            int idx = i;
            bool active = AppState.CurrentStep == idx;
            <button class="@(active
                              ? "flex items-center gap-1.5 text-xs font-semibold text-blue-400"
                              : "flex items-center gap-1.5 text-xs text-gray-600 hover:text-gray-400 transition-colors")"
                    @onclick="() => AppState.GoToStep(idx)">
                <span class="@(active ? "w-2 h-2 rounded-full bg-blue-400" : "w-2 h-2 rounded-full bg-gray-700")"></span>
                @_stepLabels[idx]
            </button>
        }
    </div>

    <button class="px-5 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 text-sm font-medium
                   disabled:opacity-30 disabled:cursor-not-allowed transition-colors"
            @onclick="AppState.NextStep"
            disabled="@(!AppState.CanAdvance)">
        Next →
    </button>
</div>

@code {
    private static readonly string[] _stepLabels = ["Trailer", "Pallet", "Results"];

    protected override void OnInitialized() => AppState.OnChange += StateHasChanged;
    public void Dispose()                   => AppState.OnChange -= StateHasChanged;
}
