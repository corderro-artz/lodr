@inject CapacityService CapSvc

<div class="fixed inset-0 z-50 flex flex-col justify-end">
    <div class="absolute inset-0 bg-black/50" @onclick="() => OnClose.InvokeAsync()"></div>
    <div class="relative bg-gray-950 border-t border-gray-800 shadow-2xl flex flex-col"
         style="height: calc(100vh - 3rem);">


        @* ── Header ── *@
        <div class="flex items-start justify-between px-6 pt-5 pb-4 border-b border-gray-800 flex-shrink-0">
            <div>
                <h2 class="text-base font-bold text-white tracking-tight">Layout Audit — @Trailer.Id</h2>
                <p class="text-xs text-gray-500 mt-0.5">
                    Interior @((int)Trailer.Dimensions.Length)" L ×
                    @((int)Trailer.Dimensions.Width)" W ×
                    @((int)Trailer.Dimensions.Height)" H
                    &nbsp;·&nbsp;
                    Floor @((int)(Trailer.Dimensions.Length * Trailer.Dimensions.Width)) in²
                    &nbsp;·&nbsp;
                    @TrailerCuFt.ToString("F0") cu ft total volume
                </p>
            </div>
            <button class="text-gray-500 hover:text-white text-xl leading-none mt-0.5 transition-colors"
                    @onclick="() => OnClose.InvokeAsync()">✕</button>
        </div>

        <div class="overflow-y-auto flex-1 min-h-0 px-6 py-5 flex flex-col gap-6">

            @* ── Volume / space summary (always shown) ── *@
            <div class="rounded-xl border @(SpatiallyFull ? "border-red-800/60 bg-red-950/20" : "border-gray-800 bg-gray-900") overflow-hidden">
                <div class="grid grid-cols-3 divide-x divide-gray-800">
                    <div class="px-5 py-4">
                        <p class="text-[10px] text-gray-500 uppercase tracking-wider mb-1">Trailer volume</p>
                        <p class="text-2xl font-bold text-white">@TrailerCuFt.ToString("F1")</p>
                        <p class="text-xs text-gray-500 mt-0.5">cu ft total</p>
                    </div>
                    <div class="px-5 py-4">
                        <p class="text-[10px] text-gray-500 uppercase tracking-wider mb-1">Used by pallets</p>
                        <p class="text-2xl font-bold text-white">@PlacedCuFt.ToString("F1")</p>
                        <p class="text-xs text-gray-500 mt-0.5">cu ft (@AreaPct.ToString("F0")% floor area)</p>
                    </div>
                    <div class="px-5 py-4">
                        <p class="text-[10px] text-gray-500 uppercase tracking-wider mb-1">Remaining volume</p>
                        <p class="text-2xl font-bold @(SpatiallyFull ? "text-red-400" : "text-green-400")">@RemainCuFt.ToString("F1")</p>
                        <p class="text-xs @(SpatiallyFull ? "text-red-500" : "text-gray-500") mt-0.5">
                            @(SpatiallyFull ? "No pallet fits in remaining space" : "cu ft available")
                        </p>
                    </div>
                </div>

                @* Per-type remaining capacity *@
                @if (PalletTypes.Any())
                {
                    <div class="border-t border-gray-800 bg-gray-800/30 px-5 py-3 flex flex-wrap gap-2 text-xs">
                        @foreach (var type in PalletTypes)
                        {
                            int remaining = CapSvc.CountRemainingSlots(Trailer, type, PalletTypes);
                            <span class="flex items-center gap-1.5 bg-gray-800 rounded-full px-3 py-1">
                                <span class="w-2 h-2 rounded-full flex-shrink-0" style="background:@type.Color"></span>
                                @if (remaining == 0)
                                {
                                    <span class="text-gray-500">@type.Name: none fit</span>
                                }
                                else
                                {
                                    <span class="text-green-400 font-medium">@remaining more @type.Name</span>
                                }
                            </span>
                        }
                    </div>
                }
            </div>

            @* ── Mixed load per-type breakdown ── *@
            @if (PlacedTypeCount > 1)
            {
                <div class="rounded-xl border border-blue-800/50 bg-blue-950/20 p-5">
                    <p class="text-xs font-semibold text-blue-400 uppercase tracking-widest mb-4">Mixed Load — Per-Type Breakdown</p>
                    <div class="flex flex-col">
                        @foreach (var type in PalletTypes)
                        {
                            int placed    = Trailer.PlacedPallets.Count(p => p.TypeId == type.Id);
                            if (placed == 0) continue;
                            int soloMax   = CapSvc.GetCapacity(Trailer.Dimensions, type);
                            float typeArea = PlacedAreaForType(type);
                            float typeCuFt = PlacedCuFtForType(type);
                            <div class="flex items-center gap-3 text-xs py-2 border-b border-gray-800/50 last:border-0 flex-wrap">
                                <span class="w-2.5 h-2.5 rounded-full flex-shrink-0" style="background:@type.Color"></span>
                                <span class="text-white font-medium">@type.Name</span>
                                <span class="text-gray-500">@placed placed</span>
                                <span class="text-gray-700">·</span>
                                <span class="text-gray-500">@soloMax solo max</span>
                                <span class="text-gray-700">·</span>
                                <span class="text-gray-400">@typeArea.ToString("F0") in² floor</span>
                                <span class="text-gray-700">·</span>
                                <span class="text-gray-400">@typeCuFt.ToString("F2") cu ft</span>
                            </div>
                        }
                    </div>
                </div>
            }

            @* ── Per-type layout math ── *@
            @if (!PalletTypes.Any())
            {
                <p class="text-sm text-gray-600 text-center py-6">No pallet types defined in this workspace.</p>
            }
            else
            {
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-widest -mb-2">
                    @(PlacedTypeCount > 1 ? "Solo Capacity — Each Type Loaded Alone" : "Layout Math")
                </p>

                @foreach (var type in PalletTypes)
                {
                    var b      = BestOrientation(type);
                    int placed = Trailer.PlacedPallets.Count(p => p.TypeId == type.Id);

                    <div class="rounded-xl border border-gray-800 bg-gray-900 overflow-hidden">

                        <div class="flex items-center gap-2 px-4 py-3 border-b border-gray-800 flex-wrap">
                            <span class="w-3 h-3 rounded-full flex-shrink-0" style="background:@type.Color"></span>
                            <span class="text-sm font-semibold text-white">@type.Name</span>
                            <span class="text-gray-600">·</span>
                            <span class="text-xs text-gray-500">@((int)b.PalletL)" × @((int)b.PalletW)"</span>
                            @if (b.Rotated)
                            {
                                <span class="text-[10px] font-medium text-amber-400 border border-amber-400/40 rounded px-1.5 py-0.5 ml-1">rotated for best fit</span>
                            }
                            <span class="ml-auto text-xs @(placed > 0 ? "text-gray-400" : "text-gray-600")">
                                @(placed > 0 ? $"{placed} placed" : "none placed")
                            </span>
                        </div>

                        <div class="grid grid-cols-2 divide-x divide-gray-800">
                            <div class="px-5 py-4">
                                <p class="text-[10px] font-semibold text-gray-500 uppercase tracking-widest mb-3">Rows along length</p>
                                <div class="flex items-baseline gap-1.5 font-mono flex-wrap">
                                    <span class="text-xl text-white">@((int)Trailer.Dimensions.Length)</span>
                                    <span class="text-gray-500">÷</span>
                                    <span class="text-xl text-white">@((int)b.PalletL)</span>
                                    <span class="text-gray-500">=</span>
                                    <span class="text-xl text-blue-400">@b.RowsRaw.ToString("F2")</span>
                                </div>
                                <div class="flex items-center gap-2 mt-2">
                                    <span class="text-gray-500">⇒</span>
                                    <span class="text-2xl font-bold text-white">@b.Rows</span>
                                    <span class="text-sm text-gray-500">full rows</span>
                                </div>
                            </div>

                            <div class="px-5 py-4">
                                <p class="text-[10px] font-semibold text-gray-500 uppercase tracking-widest mb-3">Columns across width</p>
                                <div class="flex items-baseline gap-1.5 font-mono flex-wrap">
                                    <span class="text-xl text-white">@((int)Trailer.Dimensions.Width)</span>
                                    <span class="text-gray-500">÷</span>
                                    <span class="text-xl text-white">@((int)b.PalletW)</span>
                                    <span class="text-gray-500">=</span>
                                    <span class="text-xl text-blue-400">@b.ColsRaw.ToString("F2")</span>
                                </div>
                                <div class="flex items-center gap-2 mt-2">
                                    <span class="text-gray-500">⇒</span>
                                    <span class="text-2xl font-bold text-white">@b.Cols</span>
                                    <span class="text-sm text-gray-500">columns</span>
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center gap-2 px-5 py-3 bg-gray-800/40 border-t border-gray-800 flex-wrap">
                            <span class="text-xs text-gray-500">Solo max</span>
                            <span class="font-mono text-white">@b.Rows</span>
                            <span class="text-gray-600 text-xs">rows ×</span>
                            <span class="font-mono text-white">@b.Cols</span>
                            <span class="text-gray-600 text-xs">columns =</span>
                            <span class="text-2xl font-bold text-green-400">@b.Total</span>
                            <span class="text-sm text-gray-400">pallets</span>
                            @if (b.Total > 0 && placed > 0)
                            {
                                float utilPct = (float)placed / b.Total * 100f;
                                <span class="ml-auto text-xs @(utilPct >= 100 ? "text-red-400" : utilPct >= 80 ? "text-amber-400" : "text-gray-500")">
                                    @utilPct.ToString("F0")% of solo capacity used
                                </span>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public TrailerInstance Trailer { get; set; } = null!;
    [Parameter, EditorRequired] public IReadOnlyList<PalletType> PalletTypes { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }

    private bool   SpatiallyFull => CapSvc.IsSpatiallyFull(Trailer, PalletTypes);
    private float  TrailerCuFt   => Trailer.Dimensions.Length * Trailer.Dimensions.Width * Trailer.Dimensions.Height / 1728f;
    private float  AreaPct       => CapSvc.GetAreaFraction(Trailer, PalletTypes) * 100f;
    private float  RemainCuFt    => Math.Max(0f, TrailerCuFt - PlacedCuFt);
    private int    PlacedTypeCount => Trailer.PlacedPallets.Select(p => p.TypeId).Distinct().Count();

    private float PlacedCuFt =>
        Trailer.PlacedPallets.Sum(p =>
        {
            var t = PalletTypes.FirstOrDefault(t => t.Id == p.TypeId);
            if (t is null) return 0f;
            float l = p.Rotated ? t.Width  : t.Length;
            float w = p.Rotated ? t.Length : t.Width;
            return l * w * t.Height / 1728f;
        });

    private float PlacedCuFtForType(PalletType type) =>
        Trailer.PlacedPallets
            .Where(p => p.TypeId == type.Id)
            .Sum(p =>
            {
                float l = p.Rotated ? type.Width  : type.Length;
                float w = p.Rotated ? type.Length : type.Width;
                return l * w * type.Height / 1728f;
            });

    private float PlacedAreaForType(PalletType type) =>
        Trailer.PlacedPallets
            .Where(p => p.TypeId == type.Id)
            .Sum(p =>
            {
                float l = p.Rotated ? type.Width  : type.Length;
                float w = p.Rotated ? type.Length : type.Width;
                return l * w;
            });

    private record OrientResult(
        float PalletL, float PalletW,
        float RowsRaw, int Rows,
        float ColsRaw, int Cols,
        int Total, bool Rotated);

    private OrientResult BestOrientation(PalletType type)
    {
        var candidates = new List<(float L, float W, bool Rotated)> { (type.Length, type.Width, false) };
        if (type.CanRotate && type.Length != type.Width)
            candidates.Add((type.Width, type.Length, true));
        OrientResult? best = null;
        foreach (var (l, w, rotated) in candidates)
        {
            float rowsRaw = Trailer.Dimensions.Length / l;
            float colsRaw = Trailer.Dimensions.Width / w;
            int rows = (int)Math.Floor(rowsRaw);
            int cols = (int)Math.Floor(colsRaw);
            int total = rows * cols;
            var r = new OrientResult(l, w, rowsRaw, rows, colsRaw, cols, total, rotated);
            if (best is null || total > best.Total) best = r;
        }
        return best!;
    }
}
