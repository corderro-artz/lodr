@inject AppState AppState
@inject VisualizationInterop VizInterop
@implements IDisposable

<div class="h-full flex gap-4 p-6">

    @* Stats panel *@
    <div class="w-56 flex-none flex flex-col gap-4">
        <h2 class="text-xl font-bold">Results</h2>

        @if (AppState.Result is not null)
        {
            <div class="bg-gray-800 rounded-xl p-4">
                <p class="text-xs text-gray-500 uppercase tracking-wide">Total Fit</p>
                <p data-total-fit class="text-5xl font-black text-green-400 leading-none mt-1">
                    @AppState.Result.TotalFit
                </p>
                <p class="text-xs text-gray-600 mt-1">pallets</p>
            </div>

            <div class="bg-gray-800 rounded-xl p-4 flex flex-col gap-3 text-sm">
                <div class="flex justify-between">
                    <span class="text-gray-500">Pallet L</span>
                    <span>@AppState.Result.Pallet.Length&#34;</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-500">Pallet W</span>
                    <span>@AppState.Result.Pallet.Width&#34;</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-500">Trailer L</span>
                    <span>@AppState.Result.Trailer.Length&#34;</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-500">Trailer W</span>
                    <span>@AppState.Result.Trailer.Width&#34;</span>
                </div>
            </div>
        }
        else
        {
            <div class="bg-gray-800 rounded-xl p-4 text-gray-500 text-sm">
                Calculating&hellip;
            </div>
        }
    </div>

    @* Canvas panel *@
    <div class="flex-1 bg-gray-900 rounded-2xl overflow-hidden relative" @ref="_canvasContainer">
        <canvas id="lodr-canvas" class="w-full h-full" />
    </div>
</div>

@code {
    private ElementReference _canvasContainer;
    private PlacementResult? _lastRendered;
    private bool _canvasReady;

    protected override void OnInitialized()
    {
        AppState.OnChange += OnAppStateChanged;
        AppState.Calculate();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await VizInterop.InitAsync("lodr-canvas", 900, 500);
            _canvasReady = true;
        }

        if (_canvasReady && AppState.Result is not null && AppState.Result != _lastRendered)
        {
            _lastRendered = AppState.Result;
            await VizInterop.RenderAsync(AppState.Result);
        }
    }

    private void OnAppStateChanged()
    {
        InvokeAsync(async () =>
        {
            StateHasChanged();
            if (_canvasReady && AppState.Result is not null && AppState.Result != _lastRendered)
            {
                _lastRendered = AppState.Result;
                await VizInterop.RenderAsync(AppState.Result);
            }
        });
    }

    public void Dispose() => AppState.OnChange -= OnAppStateChanged;
}
